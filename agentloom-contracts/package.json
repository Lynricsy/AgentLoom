{
  "name": "@agentloom/contracts",
  "version": "0.1.0",
  "description": "AgentLoom 跨端契约层：server / studio / mobile 共享的 wire 格式唯一来源",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "pnpm build",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "^8.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "license": "GPL-3.0-only"
}
