# Server 专属契约
APP_JWT_SECRET=change-me-jwt-secret
APP_MASTER_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES

# server/worker 仅持有 runtime manager client 证书；路径由部署 spec 只读挂载。
# CA/CERT/KEY 为全节点共用的 client 身份（manager 只校验签发 CA，不校验 CN/SAN）。
# URL/SERVER_NAME 仅在 sandbox_runtime_nodes 表为空时用于播种 default 节点；
# 多节点部署经 /api/v1/sandbox-nodes 管理，表非空后这两项不再回写。
APP_FIRECRACKER_RUNTIME_URL=https://firecracker-runtime:8443
APP_FIRECRACKER_RUNTIME_CA=/run/secrets/firecracker-manager-ca
APP_FIRECRACKER_RUNTIME_CERT=/run/secrets/firecracker-client-cert
APP_FIRECRACKER_RUNTIME_KEY=/run/secrets/firecracker-client-key
APP_FIRECRACKER_RUNTIME_SERVER_NAME=firecracker-runtime
APP_SANDBOX_MAINTENANCE_MODE=false
APP_SANDBOX_ROLLBACK_HOURS=168
# 允许管理 /api/v1/sandbox-nodes 的租户 ID（逗号分隔）。
# saas 模式留空即全部拒绝；private 模式无条件放行，可不填。
APP_SANDBOX_NODE_ADMIN_TENANT_IDS=

APP_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/callback
APP_FRONTEND_URL=http://localhost:8080

# private 模式下必须“三个都空”或“三个都提供”
APP_SUPABASE_URL=
APP_SUPABASE_ANON_KEY=
APP_SUPABASE_SERVICE_KEY=

APP_PRIVATE_DEPLOYMENT_LICENSE_PUBLIC_KEY=
FIREBASE_SERVICE_ACCOUNT=
