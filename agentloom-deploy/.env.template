# =========================
# 私有部署基础设置
# =========================

# 两个 compose 文件各自的 project 名。不要设置 COMPOSE_PROJECT_NAME：
# 它优先于文件内的 name:，会把主栈与 Supabase 栈并进同一个 project。
AGENTLOOM_PROJECT_NAME=agentloom-private
AGENTLOOM_SUPABASE_PROJECT_NAME=agentloom-supabase
# 主栈 4 个网络名的前缀（<前缀>-frontend/-app/-data/-sandbox-egress）；备份/恢复脚本据此找到 MinIO 网络。
AGENTLOOM_NETWORK_PREFIX=agentloom

NGINX_HTTP_PORT=8080
MINIO_CONSOLE_PORT=9001
QDRANT_HTTP_PORT=6333

SERVER_IMAGE=agentloom/server:private-local
# Gate 5 浏览器验收 runner：server 镜像的 browser-runner 构建目标（多一层 Chromium）
BROWSER_RUNNER_IMAGE=agentloom/server:private-local-browser-runner
STUDIO_IMAGE=agentloom/studio:private-local
DOCS_IMAGE=agentloom/docs:private-local
NGINX_IMAGE=openresty/openresty:alpine
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
# MinIO 官方 Docker Hub 仓库（minio/minio、minio/mc）已于 2026-09 下架，quay.io/minio 匿名不可拉取；
# 改用 Pigsty 维护的社区构建（https://github.com/pgsty/minio），固定 RELEASE 标签。
MINIO_IMAGE=pgsty/minio:RELEASE.2026-08-04T00-00-00Z
QDRANT_IMAGE=qdrant/qdrant:v1.17.0
MC_IMAGE=pgsty/mc:RELEASE.2026-09-16T00-00-00Z

RUN_DB_SEED=false
POSTGRES_BACKUP_RETENTION_DAYS=7
MINIO_BACKUP_RETENTION_DAYS=7

# =========================
# 共享应用契约（Compose / Helm 同名）
# =========================

APP_DEPLOYMENT_MODE=private
APP_NODE_ENV=production
APP_PORT=3000

POSTGRES_USER=agentloom
# ⚠ 仅使用字母数字字符，特殊字符会破坏 URL 编码
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=agentloom
APP_DATABASE_URL=postgresql://agentloom:change-me-db-password@postgres:5432/agentloom

REDIS_PASSWORD=change-me-redis-password
APP_REDIS_URL=redis://:change-me-redis-password@redis:6379/0

APP_MINIO_ENDPOINT=minio
APP_MINIO_PORT=9000
APP_MINIO_ACCESS_KEY=agentloom
APP_MINIO_SECRET_KEY=change-me-minio-password
APP_MINIO_USE_SSL=false
APP_MINIO_BUCKET=agentloom-documents
# 浏览器打开预签名下载链接（知识库原文、证据导出）的地址：reverse-proxy 把 /agentloom-documents/ 转给 MinIO。
# 留空时取 APP_FRONTEND_URL；只能是 协议://主机[:端口]，不能带路径。
APP_MINIO_PUBLIC_URL=

APP_QDRANT_URL=http://qdrant:6333

# TypeSafe Jev 决策 API Key；设置后以影子模式调用 Jev 并写入 decision_records，留空即不调用
APP_TYPESAFE_API_KEY=
# TypeSafe API 基址
APP_TYPESAFE_BASE_URL=https://api.typesafe.ai
# 钉版的 Jev 模型名
APP_TYPESAFE_MODEL=jev-1.13.0
# 单次 Jev 影子调用超时（毫秒）
APP_TYPESAFE_TIMEOUT_MS=3000

# Sandbox 由 Firecracker runtime manager 通过 KVM microVM 承载。
# 单机 compose 即单节点；跨服务器部署时每台宿主机各跑一个 runtime 容器，
# 用 scripts/generate-firecracker-pki.sh add-node 签发证书后经
# /api/v1/sandbox-nodes 注册（详见 README「沙箱运行时节点」）。
# 首次部署前运行 scripts/generate-firecracker-pki.sh 和 firecracker/build-artifacts.sh。
# firecracker-runtime 属于 compose profile `sandbox`。server/worker 对它是可选依赖：runtime 预检失败或
# 未启用 sandbox profile 时 server/worker 照常启动，仅 sandbox 运行态的 Agent 不可用（no_sandbox 不受影响）。
# 宿主不满足预检（KVM、内核 6.18.x、关闭 swap 等）时去掉 sandbox，省掉一个反复重启的容器。
COMPOSE_PROFILES=sandbox
FIRECRACKER_RUNTIME_IMAGE=agentloom/firecracker-runtime:1.16.1
FIRECRACKER_GUEST_CIDR=172.30.0.0/16
FIRECRACKER_GATEWAY=172.30.0.1
# 默认拒绝所有私网；仅在 private LLM/MCP 确有需要时填逗号分隔 IPv4 CIDR。
FIRECRACKER_EGRESS_ALLOWED_PRIVATE_CIDRS=
FIRECRACKER_MAX_VMS=20
FIRECRACKER_MAX_VCPU=20
FIRECRACKER_MAX_MEMORY_MIB=40960
FIRECRACKER_MAX_DISK_GIB=200
FIRECRACKER_ALLOW_UNSUPPORTED_KERNEL=false
FIRECRACKER_SMT_POLICY=deny
APP_SANDBOX_MAINTENANCE_MODE=false
APP_SANDBOX_ROLLBACK_HOURS=168
# 允许管理 /api/v1/sandbox-nodes 的租户 ID（逗号分隔）。
# saas 模式留空即全部拒绝；private 模式无条件放行，可不填。
APP_SANDBOX_NODE_ADMIN_TENANT_IDS=
# 允许在 server/worker 宿主容器内启动 stdio MCP 进程（等同任意命令执行）。
# 多租户（saas）部署必须保持 false；仅单租户自托管且信任全部 owner/admin 时开启。
APP_MCP_STDIO_ENABLED=false
# 每个 server/worker 进程同时执行的 Agent 对话数；server 与 worker 各自生效，总并发为两者之和。
# 同一对话始终串行。提高前按每个对话的内存占用与模型供应商并发配额估算。
APP_AGENT_CONVERSATION_CONCURRENCY=10
# Gate 5 浏览器验收：runner 打开的 Studio 公开页基址。Compose 内网经 reverse-proxy 同源访问 Studio 与 API，一般不改
APP_GENERATED_APP_BROWSER_BASE_URL=http://reverse-proxy
# 每个 runner 容器同时执行的验收任务数；每个任务一个 Chromium（约 1GB 内存），提高前同步调大容器内存
APP_GENERATED_APP_BROWSER_CONCURRENCY=1
# 单个场景 × 视口的时限与一次验收的总时限（毫秒）；被绑定工作流/Agent 执行慢时调大
APP_GENERATED_APP_BROWSER_SCENARIO_TIMEOUT_MS=180000
APP_GENERATED_APP_BROWSER_TOTAL_TIMEOUT_MS=900000

# =========================
# Server 专属契约
# =========================

# ⚠ 生产环境必须替换！运行 scripts/generate-secrets.sh 自动生成
APP_JWT_SECRET=change-me-jwt-secret
# 必须是 32 字节 Base64；运行: openssl rand -base64 32
APP_MASTER_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES

# 公网部署请改成实际 HTTPS 域名；保留 localhost 会导致 OAuth / 邮件跳转回本机地址。
APP_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/callback
APP_FRONTEND_URL=http://localhost:8080
# 对外公开访问的站点基址（A2A Agent Card 的 RPC 地址前缀）；留空时取 APP_FRONTEND_URL 的 origin（Studio 与 API 不同源时必须设置）
APP_PUBLIC_BASE_URL=
# server 前方可信反向代理跳数：compose 自带 reverse-proxy 为 1；外层再套一层 TLS 终止代理时改为 2
APP_TRUST_PROXY_HOPS=1
# sandbox 容器需要回调到创建 session 的同一进程，server / worker 不能共用同一个地址
APP_SANDBOX_CALLBACK_BASE_URL_SERVER=http://server:3000/api/v1
APP_SANDBOX_CALLBACK_BASE_URL_WORKER=http://worker:3000/api/v1

# private 模式下这 3 个变量必须"全部留空"或"全部提供"
# 使用自托管 Supabase 时，由 generate-secrets.sh 自动填充
APP_SUPABASE_URL=
APP_SUPABASE_ANON_KEY=
APP_SUPABASE_SERVICE_KEY=

APP_PRIVATE_DEPLOYMENT_LICENSE_PUBLIC_KEY=
FIREBASE_SERVICE_ACCOUNT=

# =========================
# Studio 专属契约
# =========================

VITE_API_BASE_URL=/api/v1
VITE_AUTOSAVE_DEBOUNCE_MS=2000
# Supabase Auth — 浏览器端直连地址（留空时前端回退到当前站点 origin，并通过 reverse-proxy 的 /auth 转发）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =========================
# 自托管 Supabase（可选）
# =========================
# 共享 Docker 网络名，docker-compose.supabase.yml 与主 Compose 通过此网络互联
SUPABASE_NETWORK=supabase-shared
# GoTrue JWT secret — 必须与 APP_JWT_SECRET 相同！
SUPABASE_JWT_SECRET=change-me-jwt-secret
# GoTrue 配置
SUPABASE_KONG_PORT=8000
# 公网部署请改成实际 HTTPS 域名；reverse-proxy 会把 /auth/* 转发到 supabase-kong。
SUPABASE_GOTRUE_EXTERNAL_URL=http://localhost:8000
SUPABASE_SITE_URL=http://localhost:8080
SUPABASE_ADDITIONAL_REDIRECT_URLS=
# Supabase 容器资源限制（默认给出较宽松基线，可按宿主资源继续调大）
SUPABASE_AUTH_CPU_LIMIT=1
SUPABASE_AUTH_MEMORY_LIMIT=1G
SUPABASE_KONG_CPU_LIMIT=1
SUPABASE_KONG_MEMORY_LIMIT=1G
SUPABASE_KONG_HEALTHCHECK_TIMEOUT=10s
SUPABASE_KONG_HEALTHCHECK_RETRIES=10
SUPABASE_KONG_HEALTHCHECK_START_PERIOD=30s
# OAuth providers（可选，设为 true 并填写 CLIENT_ID/SECRET 启用）
SUPABASE_GOOGLE_ENABLED=false
SUPABASE_GOOGLE_CLIENT_ID=
SUPABASE_GOOGLE_SECRET=
SUPABASE_GITHUB_ENABLED=false
SUPABASE_GITHUB_CLIENT_ID=
SUPABASE_GITHUB_SECRET=
