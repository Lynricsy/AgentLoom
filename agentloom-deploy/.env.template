# =========================
# 私有部署基础设置
# =========================

COMPOSE_PROJECT_NAME=agentloom-private

NGINX_HTTP_PORT=8080
MINIO_CONSOLE_PORT=9001
QDRANT_HTTP_PORT=6333

SERVER_IMAGE=agentloom/server:private-local
STUDIO_IMAGE=agentloom/studio:private-local
DOCS_IMAGE=agentloom/docs:private-local
NGINX_IMAGE=openresty/openresty:alpine
POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-02-28T09-55-16Z
QDRANT_IMAGE=qdrant/qdrant:v1.14.0
MC_IMAGE=minio/mc:RELEASE.2025-05-21T01-59-54Z

RUN_DB_SEED=false
POSTGRES_BACKUP_RETENTION_DAYS=7
MINIO_BACKUP_RETENTION_DAYS=7

# =========================
# 共享应用契约（Compose / Helm 同名）
# =========================

APP_DEPLOYMENT_MODE=private
APP_NODE_ENV=production
APP_PORT=3000

POSTGRES_USER=agentloom
# ⚠ 仅使用字母数字字符，特殊字符会破坏 URL 编码
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=agentloom
APP_DATABASE_URL=postgresql://agentloom:change-me-db-password@postgres:5432/agentloom

REDIS_PASSWORD=change-me-redis-password
APP_REDIS_URL=redis://:change-me-redis-password@redis:6379/0

APP_MINIO_ENDPOINT=minio
APP_MINIO_PORT=9000
APP_MINIO_ACCESS_KEY=agentloom
APP_MINIO_SECRET_KEY=change-me-minio-password
APP_MINIO_USE_SSL=false
APP_MINIO_BUCKET=agentloom-documents

APP_QDRANT_URL=http://qdrant:6333

# Sandbox lifecycle 通过宿主 Docker daemon 拉起 agentloom/sandbox:latest。
# Linux 主机请设置为: stat -c '%g' /var/run/docker.sock
HOST_DOCKER_GID=969

# =========================
# Server 专属契约
# =========================

# ⚠ 生产环境必须替换！运行 scripts/generate-secrets.sh 自动生成
APP_JWT_SECRET=change-me-jwt-secret
# 必须是 32 字节 Base64；运行: openssl rand -base64 32
APP_MASTER_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES

APP_OAUTH_REDIRECT_URL=http://localhost:8080/api/v1/auth/oauth/callback
APP_FRONTEND_URL=http://localhost:8080
# sandbox 容器需要回调到创建 session 的同一进程，server / worker 不能共用同一个地址
APP_SANDBOX_CALLBACK_BASE_URL_SERVER=http://server:3000/api/v1
APP_SANDBOX_CALLBACK_BASE_URL_WORKER=http://worker:3000/api/v1

# private 模式下这 3 个变量必须"全部留空"或"全部提供"
# 使用自托管 Supabase 时，由 generate-secrets.sh 自动填充
APP_SUPABASE_URL=
APP_SUPABASE_ANON_KEY=
APP_SUPABASE_SERVICE_KEY=

APP_PRIVATE_DEPLOYMENT_LICENSE_PUBLIC_KEY=
FIREBASE_SERVICE_ACCOUNT=

# =========================
# Studio 专属契约
# =========================

VITE_API_BASE_URL=/api/v1
VITE_AUTOSAVE_DEBOUNCE_MS=500
# Supabase Auth — 浏览器端直连地址（留空时前端回退到当前站点 origin，并通过 reverse-proxy 的 /auth 转发）
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# =========================
# 自托管 Supabase（可选）
# =========================
# 共享 Docker 网络名，docker-compose.supabase.yml 与主 Compose 通过此网络互联
SUPABASE_NETWORK=supabase-shared
# GoTrue JWT secret — 必须与 APP_JWT_SECRET 相同！
SUPABASE_JWT_SECRET=change-me-jwt-secret
# GoTrue 配置
SUPABASE_KONG_PORT=8000
SUPABASE_GOTRUE_EXTERNAL_URL=http://localhost:8000
SUPABASE_SITE_URL=http://localhost:8080
SUPABASE_ADDITIONAL_REDIRECT_URLS=
# Supabase 容器资源限制（默认给出较宽松基线，可按宿主资源继续调大）
SUPABASE_AUTH_CPU_LIMIT=1
SUPABASE_AUTH_MEMORY_LIMIT=1G
SUPABASE_KONG_CPU_LIMIT=1
SUPABASE_KONG_MEMORY_LIMIT=1G
SUPABASE_KONG_HEALTHCHECK_TIMEOUT=10s
SUPABASE_KONG_HEALTHCHECK_RETRIES=10
SUPABASE_KONG_HEALTHCHECK_START_PERIOD=30s
# OAuth providers（可选，设为 true 并填写 CLIENT_ID/SECRET 启用）
SUPABASE_GOOGLE_ENABLED=false
SUPABASE_GOOGLE_CLIENT_ID=
SUPABASE_GOOGLE_SECRET=
SUPABASE_GITHUB_ENABLED=false
SUPABASE_GITHUB_CLIENT_ID=
SUPABASE_GITHUB_SECRET=
