table inet agentloom_firecracker {
  set guest_ips {
    type ipv4_addr
    flags interval
    elements = { ${FIRECRACKER_GUEST_IPS} }
  }

  set allowed_private_cidrs {
    type ipv4_addr
    flags interval
    elements = { ${FIRECRACKER_ALLOWED_PRIVATE_CIDRS} }
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    ct state established,related accept
    iifname "agentloom-fc0" oifname "agentloom-fc0" drop
    iifname "tap*" ip saddr != @guest_ips drop
    iifname "tap*" ip daddr 169.254.169.254 drop
    iifname "tap*" ip daddr 127.0.0.0/8 drop
    iifname "tap*" ip daddr 169.254.0.0/16 drop
    iifname "tap*" ip daddr 10.0.0.0/8 ip daddr != @allowed_private_cidrs drop
    iifname "tap*" ip daddr 172.16.0.0/12 ip daddr != @allowed_private_cidrs drop
    iifname "tap*" ip daddr 192.168.0.0/16 ip daddr != @allowed_private_cidrs drop
    iifname "tap*" ip daddr 100.64.0.0/10 drop
    iifname "tap*" ip daddr 198.18.0.0/15 drop
    iifname "tap*" ip daddr 224.0.0.0/4 drop
    iifname "tap*" ip daddr 240.0.0.0/4 drop
    iifname "tap*" udp dport 53 accept
    iifname "tap*" tcp dport { 53, 80, 443 } accept
  }

  chain input {
    type filter hook input priority filter; policy accept;
    iifname "tap*" tcp dport 8443 drop
    iifname "tap*" ip daddr ${FIRECRACKER_GATEWAY} tcp dport != 18080 drop
  }
}
