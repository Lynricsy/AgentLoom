[Unit]
Description=AgentLoom PostgreSQL 每小时逻辑备份
Wants=docker.service
After=docker.service

[Service]
Type=oneshot
Environment=AGENTLOOM_DEPLOY_DIR=/opt/agentloom/agentloom-deploy
ExecStart=/usr/bin/env bash -lc 'ENV_FILE="${AGENTLOOM_DEPLOY_DIR}/.env" COMPOSE_FILE="${AGENTLOOM_DEPLOY_DIR}/docker-compose.yml" "${AGENTLOOM_DEPLOY_DIR}/scripts/backup-postgres.sh"'

[Install]
WantedBy=multi-user.target
