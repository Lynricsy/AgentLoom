{
  "name": "@agentloom/sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone Fastify HTTP server wrapping pi-coding-agent AgentSession behind ACP-compatible endpoints",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsup src/server.ts --format esm --target node22 --dts --clean",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.3.3",
    "@earendil-works/pi-coding-agent": "file:.pi-tarballs/pi-coding-agent.tgz",
    "typebox": "^1.3.7",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "grok-search": "0.3.0",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": "file:.pi-tarballs/pi-coding-agent.tgz",
    "@earendil-works/pi-ai": "file:.pi-tarballs/pi-ai.tgz",
    "@earendil-works/pi-agent-core": "file:.pi-tarballs/pi-agent-core.tgz",
    "@earendil-works/pi-tui": "file:.pi-tarballs/pi-tui.tgz",
    "@earendil-works/pi-telemetry": "file:.pi-tarballs/pi-telemetry.tgz",
    "@earendil-works/pi-protocol": "file:.pi-tarballs/pi-protocol.tgz",
    "@earendil-works/pi-client": "file:.pi-tarballs/pi-client.tgz"
  },
  "allowScripts": {
    "esbuild@0.27.4": true,
    "grok-search@0.3.0": true,
    "koffi@2.15.2": true,
    "node-pty@1.1.0": true,
    "protobufjs@7.5.4": true
  }
}
