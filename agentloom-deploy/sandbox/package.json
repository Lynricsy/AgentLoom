{
  "name": "@agentloom/sandbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone Fastify HTTP server running a DeepSeek Harness (dsh) agent runtime behind ACP-compatible endpoints",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ast-grep/lang-bash": "0.0.8",
    "@ast-grep/lang-c": "0.0.6",
    "@ast-grep/lang-cpp": "0.0.6",
    "@ast-grep/lang-go": "0.0.6",
    "@ast-grep/lang-java": "0.0.7",
    "@ast-grep/lang-json": "0.0.7",
    "@ast-grep/lang-python": "0.0.6",
    "@ast-grep/lang-rust": "0.0.7",
    "@ast-grep/lang-yaml": "0.0.6",
    "@ast-grep/napi": "0.51.1",
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sdk-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "fastify": "^5.3.3",
    "grok-search": "0.3.0",
    "node-pty": "^1.0.0",
    "puppeteer-core": "25.16.0",
    "vscode-jsonrpc": "10.0.0",
    "vscode-languageserver-protocol": "3.18.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.2.0-rc.2",
    "@types/node": "^22.15.18",
    "tsup": "^8.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "allowScripts": {
    "@ast-grep/lang-bash@0.0.8": true,
    "@ast-grep/lang-c@0.0.6": true,
    "@ast-grep/lang-cpp@0.0.6": true,
    "@ast-grep/lang-go@0.0.6": true,
    "@ast-grep/lang-java@0.0.7": true,
    "@ast-grep/lang-json@0.0.7": true,
    "@ast-grep/lang-python@0.0.6": true,
    "@ast-grep/lang-rust@0.0.7": true,
    "@ast-grep/lang-yaml@0.0.6": true,
    "@deepseek-ai/dsh-subprocess-local@0.2.0-rc.2": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true,
    "grok-search@0.3.0": true,
    "koffi@3.1.1": true,
    "node-pty@1.1.0": true,
    "node-pty@1.2.0-beta.15": true,
    "protobufjs@7.6.6": true
  }
