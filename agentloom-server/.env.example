# 应用配置
APP_PORT=3000
APP_NODE_ENV=development
# server 前方可信反向代理跳数（Fastify trustProxy）；本地直连保持 0，compose/nginx 后为 1
APP_TRUST_PROXY_HOPS=0

# 数据库连接
APP_DATABASE_URL=postgresql://user:pass@localhost:5432/agentloom

# Supabase 配置
APP_SUPABASE_URL=http://localhost:54321
APP_SUPABASE_ANON_KEY=<anon-key>
APP_SUPABASE_SERVICE_KEY=<service-role-key>

# JWT 密钥（Supabase JWT Secret）
APP_JWT_SECRET=<supabase-jwt-secret>

# Redis 连接
APP_REDIS_URL=redis://localhost:6379

# 加密配置（256 位 Base64 编码密钥，可用 `openssl rand -base64 32` 生成）
APP_MASTER_ENCRYPTION_KEY=

# OAuth 配置
APP_OAUTH_REDIRECT_URL=http://localhost:3000/api/v1/auth/oauth/callback
APP_FRONTEND_URL=http://localhost:5173
# 可选：sandbox 容器回调当前进程的 API 基址（容器化部署建议显式配置）
APP_SANDBOX_CALLBACK_BASE_URL=
# Firecracker runtime manager（server/worker 仅持有 mTLS client 身份）
# URL/SERVER_NAME 仅在 sandbox_runtime_nodes 表为空时用于播种 default 节点；
# 多节点部署经 /api/v1/sandbox-nodes 管理，表非空后这两项不再回写。
# CA/CERT/KEY 为全节点共用的 client 身份（manager 只校验签发 CA）。
APP_FIRECRACKER_RUNTIME_URL=https://firecracker-runtime:8443
APP_FIRECRACKER_RUNTIME_CA=/run/secrets/firecracker-client/ca.crt
APP_FIRECRACKER_RUNTIME_CERT=/run/secrets/firecracker-client/tls.crt
APP_FIRECRACKER_RUNTIME_KEY=/run/secrets/firecracker-client/tls.key
APP_FIRECRACKER_RUNTIME_SERVER_NAME=firecracker-runtime
# 允许管理沙箱节点的租户 ID（逗号分隔）；saas 模式下留空即全部拒绝，private 模式无条件放行
APP_SANDBOX_NODE_ADMIN_TENANT_IDS=
# Agent 对外 API：API 对话空闲多少小时后由维护任务自动结束
APP_AGENT_API_CONVERSATION_IDLE_HOURS=24

# MinIO 对象存储配置
APP_MINIO_ENDPOINT=localhost
APP_MINIO_PORT=9000
APP_MINIO_ACCESS_KEY=minioadmin
APP_MINIO_SECRET_KEY=minioadmin
APP_MINIO_USE_SSL=false
APP_MINIO_BUCKET=agentloom-documents

# 向量数据库（Qdrant）
APP_QDRANT_URL=http://localhost:6333

# Firebase Cloud Messaging（推送通知）
# Firebase 服务账号 JSON 字符串，留空即禁用推送，例如 {"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_SERVICE_ACCOUNT=

# 生成应用门禁（可选）
# 生成工作区根目录，留空使用系统临时目录下的 agentloom-generated-app-workspaces
GENERATED_APP_WORKSPACE_ROOT=
# Gate 3-7 执行模式：real（缺省）| fixture | disabled；Gate 5 另支持 real-browser-e2e
GENERATED_APP_GATE3_EXECUTOR_MODE=
GENERATED_APP_GATE4_EXECUTOR_MODE=
GENERATED_APP_GATE5_EXECUTOR_MODE=
GENERATED_APP_GATE6_EXECUTOR_MODE=
GENERATED_APP_GATE7_EXECUTOR_MODE=
# Gate 3 单条命令超时（毫秒）
GENERATED_APP_GATE3_COMMAND_TIMEOUT_MS=30000
# 非空时强制把 Gate 5 真实浏览器标记为不可用，值即原因
GENERATED_APP_GATE5_REAL_BROWSER_UNAVAILABLE_REASON=
