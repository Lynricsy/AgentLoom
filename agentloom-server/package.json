{
  "name": "agentloom-server",
  "version": "0.0.1",
  "description": "AgentLoom 后端服务 - NestJS + Fastify + Drizzle ORM",
  "author": "Wine Fox <fox@ling.plus>",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "build": "nest build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "start:acp:stdio": "node scripts/start-acp-stdio.mjs",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "node scripts/run-e2e.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:migrate:agent-input-nodes": "tsx scripts/migrate-agent-input-nodes.ts",
    "db:backfill:workflow-ports": "tsx scripts/backfill-workflow-port-definitions.ts",
    "db:seed": "tsx drizzle/seed/templates.ts",
    "openapi:export": "pnpm build && node scripts/export-openapi-spec.mjs",
    "sdk:export-spec": "pnpm openapi:export",
    "sdk:generate:ts": "openapi-generator-cli generate --generator-key typescript && node scripts/postprocess-typescript-sdk.mjs",
    "sdk:generate:models": "openapi-generator-cli generate --generator-key typescriptModels",
    "sdk:generate:py": "openapi-generator-cli generate --generator-key python && node scripts/postprocess-python-sdk.mjs",
    "sdk:generate": "pnpm openapi:export && pnpm sdk:generate:ts && pnpm sdk:generate:py",
    "sdk:build:ts": "tsc --noEmit -p sdk/typescript/tsconfig.json"
  },
  "dependencies": {
    "@agentloom/contracts": "workspace:*",
    "@agentloom/plugin-sdk": "workspace:*",
    "@ai-sdk/anthropic": "^3.0.58",
    "@ai-sdk/google": "^3.0.43",
    "@ai-sdk/openai": "^3.0.41",
    "@earendil-works/pi-agent-core": "0.84.4",
    "@earendil-works/pi-ai": "0.84.4",
    "@extism/extism": "2.0.0-rc13",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@llamaindex/cohere": "^0.0.37",
    "@llamaindex/core": "0.6.22",
    "@llamaindex/qdrant": "^0.1.33",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/platform-fastify": "^11.1.16",
    "@nestjs/platform-socket.io": "^11.1.16",
    "@nestjs/swagger": "^11.2.6",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.16",
    "@qdrant/js-client-rest": "1.17.0",
    "@sinclair/typebox": "^0.34.52",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.98.0",
    "@types/jmespath": "^0.15.2",
    "ahocorasick": "^1.0.2",
    "ai": "^6.0.116",
    "bullmq": "^5.70.4",
    "drizzle-orm": "^0.45.1",
    "fastify": "5.11.3",
    "file-type": "^21.3.0",
    "firebase-admin": "^13.7.0",
    "gpt-tokenizer": "^3.4.0",
    "ioredis": "^5.10.0",
    "jmespath": "^0.16.0",
    "jsonata": "^2.1.0",
    "jsonrepair": "^3.13.2",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.1",
    "llamaindex": "^0.12.1",
    "mammoth": "^1.11.0",
    "minio": "^8.0.7",
    "nestjs-zod": "^5.1.1",
    "pdf-parse": "^2.4.5",
    "postgres": "^3.4.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "undici": "^7.22.0",
    "uuid": "^13.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@openapitools/openapi-generator-cli": "^2.30.2",
    "@sinclair/typebox": "^0.34.48",
    "@swc/core": "^1.15.18",
    "@testcontainers/postgresql": "^11.12.0",
    "@types/ahocorasick": "^1.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/minio": "^7.1.1",
    "@types/node": "catalog:",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^4.0.18",
    "drizzle-kit": "^0.31.9",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "testcontainers": "^11.12.0",
    "ts-loader": "^9.5.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.20.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "catalog:"
  }
}
