{
  "name": "@agentloom/docs",
  "version": "0.1.0",
  "description": "AgentLoom Documentation",
  "private": true,
  "scripts": {
    "dev": "node --no-experimental-webstorage ./node_modules/vitepress/bin/vitepress.js dev",
    "build": "node --no-experimental-webstorage ./node_modules/vitepress/bin/vitepress.js build",
    "preview": "node --no-experimental-webstorage ./node_modules/vitepress/bin/vitepress.js preview",
    "lint:md": "markdownlint-cli2 'zh/**/*.md'",
    "prebuild": "node scripts/sync-openapi.mjs"
  },
  "dependencies": {
    "@braintree/sanitize-url": "^7.1.2",
    "cytoscape": "^3.33.1",
    "cytoscape-cose-bilkent": "^4.1.0",
    "dayjs": "^1.11.20",
    "debug": "^4.4.3",
    "mermaid": "^11.0.0",
    "vitepress": "^2.0.0-alpha.17",
    "vitepress-openapi": "latest",
    "vitepress-plugin-mermaid": "^2.0.0"
  },
  "devDependencies": {
    "markdownlint-cli2": "latest",
    "vue": "3.5.30"
  }
}
